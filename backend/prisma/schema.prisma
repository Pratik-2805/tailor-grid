// Prisma Schema for Darzi Backend
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id @default(cuid())
  name       String
  email      String?  @unique
  contact    String?
  phone      String?
  avatar     String?
  address    String?
  postcode   String?
  method     String   @default("email") // google, email, mobile, apple, guest
  role       String   @default("CUSTOMER") // CUSTOMER, STUDIO, ADMIN
  studioId   String?
  studioName String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders Order[]

  @@map("users")
}

model GarmentCategory {
  id            String   @id
  name          String
  tagline       String?
  startingPrice Float
  avgTurnaround String   @default("48 hours")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  services AlterationService[]

  @@map("garment_categories")
}

model AlterationService {
  id             String          @id
  categoryId     String
  category       GarmentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  customerPrice  Float
  partnerPayout  Float
  platformFee    Float
  turnaroundDays Int             @default(2)
  popular        Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("alteration_services")
}

model PartnerStore {
  id            String   @id
  name          String
  area          String
  address       String
  postcode      String
  distance      String?
  distanceMiles Float    @default(0.5)
  rating        Float    @default(4.9)
  reviewCount   Int      @default(100)
  openingHours  String   @default("09:00 - 19:00")
  dailyCapacity Int      @default(25)
  machines      Int      @default(6)
  workers       Int      @default(4)
  leadTailor    String
  specialties   String[]
  retailSold    Boolean  @default(true)
  lat           Float
  lng           Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders Order[]

  @@map("partner_stores")
}

model Order {
  id                    String        @id
  userId                String?
  user                  User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName          String
  customerEmail         String
  customerPhone         String?
  postcode              String
  garmentId             String
  garmentName           String
  serviceId             String
  serviceName           String
  storeId               String?
  store                 PartnerStore? @relation(fields: [storeId], references: [id], onDelete: SetNull)
  storeName             String?
  date                  String
  timeSlot              String
  garmentBrand          String?
  fitNotes              String?
  pinnedAdjustment      String?
  sewingNotes           String?
  slaHours              Int           @default(48)
  partnerPayout         Float         @default(18.0)
  retailSold            Boolean       @default(false)
  retailValue           Float?
  retailCategory        String?
  assignedWorker        String?
  machineNo             String?
  hangTagNo             String?
  intakePhotoUrl        String?
  fabricConditionNotes  String?
  priceAdjustment       Float?
  priceAdjustmentReason String?
  priceAdjustmentStatus String        @default("NONE") // NONE, PENDING_APPROVAL, APPROVED, DECLINED
  slaStartedAt          DateTime?
  rating                Float?
  ratingFeedback        String?
  status                String        @default("Allocated") // Allocated, Accepted, Customer Arrived, Fitting Completed, Work in Progress, Ready, Collected, Closed
  price                 Float
  otp                   String
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@map("orders")
}
